#include <stdio.h>
#include<math.h>

int main(){
    int n,root;
    scanf("%d",&n);
    if(n<0){
        printf("not a perfect square root");
    }
    else{
        root=sqrt(n);
        if(root*root==n){
            printf("it's perfect square root");
        }
        else{
            printf("not a perfect square root");
        }
    }

   
    return 0;
}
